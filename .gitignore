node_modules/
dist/
.env
.env.*
!.env.example
.DS_Store
*.tmp

# Your worlds: the plan, verdicts and receipts are small and worth keeping;
# photos, recordings and rendered media are large (and personal).
worlds/*/photos/
worlds/*/stills/
worlds/*/keyframes/
worlds/*/voices/
worlds/*/music/
worlds/*/renders/**/*.mp4
worlds/*/renders/**/*.jpg
worlds/*/renders/**/*.png
worlds/*/selections/**/*.png
# Outline previews are copies of your photos with the outline drawn on
worlds/*/selections/**/*.jpg
worlds/*/selections/**/*.jpeg
worlds/*/renders/**/*.jpeg
worlds/*/renders/**/*.webp
worlds/*/audio/**/*.wav
worlds/*/audio/**/*.mp3
worlds/*/build/
worlds/*/.cache/
worlds/*/renders/.render.lock
# Figures are cut out of your pictures; keep only their receipts
worlds/*/figures/**/*.png
worlds/*/figures/**/*.glb
# Area-note pictures are frames of your takes with the box drawn on; the note itself (words, time, box) stays in review/
worlds/*/review/marks/

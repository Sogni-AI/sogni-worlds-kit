# Copy to .env, or run `node world setup`, which writes the key where the
# Sogni Creative Agent Skill also finds it (~/.config/sogni/credentials).
# Get a key at https://dashboard.sogni.ai/api-key
SOGNI_API_KEY=

# How renders are paid for:
#   subscription  your Unlimited plan pays; a job it cannot cover stops instead of spending tokens
#   tokens        your Spark (or SOGNI) balance pays
#   auto          the plan pays what it covers, tokens pay the rest
# Unset: subscription when your account has an active Unlimited plan, otherwise tokens.
SOGNI_BILLING_MODE=

# Which token pays when tokens pay: spark or sogni.
SOGNI_TOKEN_TYPE=spark

# Stop before spending more than this many Spark in one `render` run without --yes.
SOGNI_MAX_SPARK=2000
